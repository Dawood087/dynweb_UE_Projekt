{% extends "base.twig" %}

{% block title %}Campus Feed{% endblock %}
{% block feed_nav_class %} active{% endblock %}
{% block footer_spacing %}mt-5{% endblock %}

{% block content %}
  <main class="container custom_feed_layout py-4">
    <header class="row justify-content-center mb-4">
      <div class="col-12 col-lg-6 custom_feed_center d-flex flex-wrap align-items-baseline justify-content-between gap-2">
        <h1 class="h2 fw-bold text-primary mb-0">Campus Feed</h1>
        {% if activeUser is not empty or activeTag is not empty or search is not empty %}
          <a href="/social.php" class="small text-decoration-none">Alle Beiträge</a>
        {% endif %}
      </div>
    </header>

    <div class="row g-4 align-items-start justify-content-center">
      <section class="col-12 col-lg-6 order-lg-2 custom_feed_center" aria-label="Beiträge">
        <form action="/social.php" method="get" class="mb-3" role="search">
          <label for="feed-search" class="visually-hidden">Beiträge durchsuchen</label>
          <div class="input-group">
            <input id="feed-search" name="q" type="search" class="form-control" placeholder="Text, Nutzer oder Hashtag" value="{{ search }}">
            <button type="submit" class="btn btn-outline-primary">Suchen</button>
          </div>
        </form>
        <div class="vstack gap-4">
          {% for post in posts %}
            {% set media = post.post_video_file|default('')|trim %}
            {% set mediaName = media|split('/')|last|lower %}
            {% set hasMedia = mediaName is not empty and mediaName != 'placeholder.jpg' %}
            {% set author = post.user_realname|default(post.username) %}
            {% set authorImage = post.user_image|default('')|trim %}
            {% set tags = post.tags is not empty ? post.tags|split(',') : [] %}

            <article id="post-{{ post.post_id }}" class="card border-0 rounded-4 shadow-sm overflow-hidden">
              <header class="d-flex align-items-center gap-2 px-3 py-3">
                {% if authorImage is not empty %}
                  <img src="http://haw-kiel.florianschatz.de/dywe/assets/images/{{ authorImage }}" class="rounded-circle custom_feed_avatar flex-shrink-0" alt="" loading="lazy"/>
                {% endif %}
                <div>
                  <h2 class="h6 fw-bold mb-0 text-break">{{ author }}</h2>
                  <a href="/social.php?user={{ post.username|url_encode }}" class="small text-primary text-decoration-none text-break">@{{ post.username }}</a>
                </div>
              </header>

              {% if hasMedia %}
                <div class="custom_feed_media mx-auto rounded-3 overflow-hidden bg-dark">
                  {% if mediaName ends with '.mp4' %}
                    {% set thumbnail = media|replace({'.mp4': '.jpg'}) %}
                    <video class="custom_feed_reel d-block w-100" controls playsinline preload="metadata"{% if post.lowresvideo_exists %} poster="http://haw-kiel.florianschatz.de/dywe/assets/videos/thumb_auto_generated/{{ thumbnail }}"{% endif %} aria-label="Video von {{ author }}">
                      <source src="http://haw-kiel.florianschatz.de/dywe/assets/videos/{% if post.lowresvideo_exists %}src_auto_generated{% else %}src{% endif %}/{{ media }}" type="video/mp4"/>
                      Dein Browser unterstützt das Video-Tag nicht.
                    </video>
                  {% else %}
                    <img src="http://haw-kiel.florianschatz.de/dywe/assets/videos/thumb_auto_generated/{{ media }}" class="custom_feed_photo d-block w-100" alt="Bild zum Beitrag von {{ author }}" loading="lazy"/>
                  {% endif %}
                </div>
              {% endif %}

              <div class="card-body custom_feed_copy px-3 pb-3 {{ hasMedia ? 'pt-3' : 'pt-0' }}">
                <p class="mb-0 text-break">{{ post.post_text }}</p>
                {% if tags is not empty %}
                  <div class="d-flex flex-wrap gap-1 mt-3">
                    {% for tag in tags %}
                      <a href="/social.php?tag={{ tag|url_encode }}" class="badge text-bg-light text-decoration-none text-wrap text-break">#{{ tag }} ({{ allTags[tag]|default(0) }})</a>
                    {% endfor %}
                  </div>
                {% endif %}
                {% if likesAvailable %}
                  {% set liked = post.post_id in likedPostIds %}
                  <form class="mt-3" action="{{ feedUrl }}" method="post">
                    <input type="hidden" name="post_id" value="{{ post.post_id }}">
                    <input type="hidden" name="like_token" value="{{ likeToken }}">
                    <input type="hidden" name="liked" value="{{ liked ? '0' : '1' }}">
                    <button type="submit" aria-pressed="{{ liked ? 'true' : 'false' }}" class="btn btn-sm rounded-pill d-inline-flex align-items-center gap-2 {{ liked ? 'btn-danger' : 'btn-outline-danger' }}">
                      <span aria-hidden="true">{{ liked ? '♥' : '♡' }}</span>
                      Gefällt mir <span class="fw-semibold">{{ post.likes }}<span class="visually-hidden"> Likes</span></span>
                    </button>
                  </form>
                {% endif %}
              </div>
            </article>
          {% else %}
            <div class="card border-0 rounded-4 shadow-sm p-4">
              <p class="mb-2 fw-bold">Keine passenden Beiträge gefunden.</p>
              <a href="/social.php" class="align-self-start">Zurück zum Campus Feed</a>
            </div>
          {% endfor %}
        </div>
      </section>

      <aside class="col-12 col-md-6 col-lg-3 order-lg-1 custom_feed_sidebar sticky-lg-top" aria-labelledby="feed-recent-heading">
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
          <h2 id="feed-recent-heading" class="h6 fw-bold text-primary mb-0 px-3 pt-3 pb-2">Zuletzt gepostet</h2>
          <div id="feed-recent-users" class="list-group list-group-flush">
            {% for poster in recentPosters %}
              {% set posterImage = poster.user_image|default('')|trim %}
              <a
                href="/social.php?user={{ poster.username|url_encode }}"{% if poster.username == activeUser %}
                aria-current="true"{% endif %}
                class="list-group-item list-group-item-action d-flex align-items-center gap-2 px-3 py-2{{ poster.username == activeUser ? ' bg-primary bg-opacity-10' : '' }}"
              >
                {% if posterImage is not empty %}
                  <img src="http://haw-kiel.florianschatz.de/dywe/assets/images/{{ posterImage }}" class="rounded-circle custom_feed_avatar flex-shrink-0" alt="" loading="lazy"/>
                {% endif %}
                <span class="text-break">
                  <strong class="d-block small">{{ poster.user_realname|default(poster.username) }}</strong>
                  <span class="d-block small text-body-secondary">@{{ poster.username }}</span>
                </span>
              </a>
            {% else %}
              <p class="small text-body-secondary mb-0 px-3 pb-3">Noch keine Beiträge.</p>
            {% endfor %}
          </div>
        </div>
      </aside>

      <aside class="col-12 col-md-6 col-lg-3 order-lg-3 custom_feed_sidebar sticky-lg-top" aria-labelledby="feed-top-tags-heading">
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden">
          <h2 id="feed-top-tags-heading" class="h6 fw-bold text-primary mb-0 px-3 pt-3 pb-2">Top 5 Hashtags</h2>
          <div id="feed-top-tags" class="list-group list-group-flush">
            {% for tag, count in topTags %}
              <a
                href="/social.php?tag={{ tag|url_encode }}"{% if tag == activeTag %}
                aria-current="true"{% endif %}
                class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-1 ps-3 pe-2 py-2{{ tag == activeTag ? ' bg-primary bg-opacity-10' : '' }}"
              >
                <span class="small fw-semibold text-break">#{{ tag }}</span>
                <span class="badge rounded-pill text-bg-light">{{ count }}<span class="visually-hidden"> {{ count == 1 ? 'Beitrag' : 'Beiträge' }}</span></span>
              </a>
            {% else %}
              <p class="small text-body-secondary mb-0 px-3 pb-3">Noch keine Hashtags.</p>
            {% endfor %}
          </div>
        </div>
      </aside>
    </div>
  </main>
{% endblock %}

{% block footer_links %}
  <a href="/start.php" class="text-white-50 text-decoration-none">Start</a>
  <a href="/social.php" class="text-white-50 text-decoration-none">Feed</a>
  <a href="/style-guide.html" class="text-white-50 text-decoration-none">Style Guide</a>
  <a href="/impressum.php" class="text-white-50 text-decoration-none">Impressum</a>
{% endblock %}
