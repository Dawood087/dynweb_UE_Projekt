{% extends "base.twig" %}
{% block title %}{{ entry.title }} | Campus-Events{% endblock %}
{% block events_nav_class %} active{% endblock %}
{% block content %}
  {% set image = entry.eventImage.one() %}
  <main class="container py-5">
    <a href="/events" class="d-inline-block mb-4 text-primary">← Alle Campus-Events</a>
    <article class="card border-0 shadow-sm overflow-hidden">
      <div class="row g-0">
        {% if image %}<div class="col-lg-6 custom_event_hero_media"><img class="custom_event_hero_image" src="{{ image.url }}" alt="{{ image.alt ?: entry.title }}"></div>{% endif %}
        <div class="col-lg-6">
          <div class="card-body p-4 p-lg-5">
            {% if entry.eventHighlight %}<p class="fw-bold text-primary">Event-Highlight</p>{% endif %}
            <p class="text-secondary">{{ entry.eventCategory.label }} · {{ entry.eventCost }}</p>
            <h1 class="fw-bold mb-4">{{ entry.title }}</h1>
            <dl class="row mb-4">
              <dt class="col-sm-4">Datum</dt><dd class="col-sm-8">{{ entry.eventDate|date('d.m.Y', timezone='Europe/Berlin') }}</dd>
              <dt class="col-sm-4">Uhrzeit</dt><dd class="col-sm-8">{{ entry.eventDate|date('H:i', timezone='Europe/Berlin') }} Uhr</dd>
              <dt class="col-sm-4">Ort</dt><dd class="col-sm-8">{{ entry.eventLocation }}</dd>
              <dt class="col-sm-4">Kosten</dt><dd class="col-sm-8">{{ entry.eventCost }}</dd>
            </dl>
            <div class="text-secondary">{{ entry.eventDescription|nl2br }}</div>
          </div>
        </div>
      </div>
    </article>
  </main>
{% endblock %}
{% block footer_links %}
  <a href="/start.php" class="text-white-50 text-decoration-none">Start</a>
  <a href="/social.php" class="text-white-50 text-decoration-none">Feed</a>
  <a href="/events" class="text-white-50 text-decoration-none">Events</a>
  <a href="/impressum.php" class="text-white-50 text-decoration-none">Impressum</a>
{% endblock %}
